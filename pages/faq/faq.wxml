<!-- filepath: d:\weixinxiaochengxu2\pages\faq\faq.wxml -->
<view class="faq-container">
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">←</text>
    <text>返回</text>
  </view>
  <view class="faq-title">常见问题解答</view>
  <block wx:for="{{faqList}}" wx:key="q">
    <view class="faq-item">
      <view class="faq-q">{{item.q}}</view>
      <view class="faq-a">{{item.a}}</view>
    </view>
  </block>
</view>