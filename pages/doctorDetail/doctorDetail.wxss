.doctor-detail {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
  background: #f8f9fc;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.info {
  margin-bottom: 32rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-right: 16rpx;
}

.title {
  font-size: 24rpx;
  color: #2b87ff;
  background: rgba(43,135,255,0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.specialty, .schedule {
  font-size: 28rpx;
  color: #666;
}

.reg-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #2b87ff 0%, #3b93ff 100%);
  font-weight: 500;
  transition: opacity 0.2s;
}

.back-btn {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx;
  margin-left: -16rpx;
}

.back-icon {
  font-size: 32rpx;
  color: #333;
}

@media (prefers-color-scheme: dark) {
  .doctor-detail {
    background: #000;
  }
  
  .name {
    color: #fff;
  }
  
  .title {
    background: rgba(43,135,255,0.2);
  }
  
  .specialty, .schedule {
    color: #888;
  }
  
  .back-icon {
    color: #fff;
  }
}