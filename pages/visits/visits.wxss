.visit-list {
  padding: 24rpx;
}
.visit-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  font-size: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.back-btn {
  display: flex;
  align-items: center;
  color: #1890ff;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}
.back-icon {
  font-size: 40rpx;
  margin-right: 8rpx;
}