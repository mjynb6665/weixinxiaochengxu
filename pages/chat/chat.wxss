.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.chat-list {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 24rpx;
}
.chat-item { margin-bottom: 16rpx; max-width: 70%; padding: 16rpx; border-radius: 12rpx; }
.chat-patient { background: #e6f7ff; align-self: flex-end; margin-left: auto; }
.chat-doctor { background: #f5f5f5; align-self: flex-start; margin-right: auto; }
.chat-img { width: 120rpx; height: 120rpx; border-radius: 8rpx; margin-top: 8rpx; }
.chat-input-bar {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0 0 0;
  background: #fff;
  align-items: center;
}
.chat-input {
  flex: 1;
  border: 1rpx solid #ccc;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 32rpx;
  min-height: 48rpx;
  background: #f8f8f8;
}
.back-btn {
  display: flex;
  align-items: center;
  color: #1890ff;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}
.back-icon {
  font-size: 40rpx;
  margin-right: 8rpx;
}
.chat-btn-bar {
  display: flex;
  gap: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  margin-bottom: 12rpx;
}
.chat-btn-bar button {
  min-width: 120rpx;
  font-size: 30rpx;
  padding: 0 12rpx;
}