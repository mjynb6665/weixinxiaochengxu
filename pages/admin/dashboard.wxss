.admin-dashboard {
  padding: 40rpx 30rpx;
  background: #f5f7fa;
  min-height: 100vh;
}
.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}
.admin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
}
.logout-btn {
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
  padding: 10rpx 30rpx;
  font-size: 28rpx;
}
.admin-section {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}
.btn-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.admin-btn {
  flex: 1;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  width: 80vw;
  max-width: 600rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.12);
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #1890ff;
  text-align: center;
}
.modal-input {
  width: 100%;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}
.modal-btn-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
}