<view class="container">
  <!-- 标题栏 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">‹ 返回</view>
    <view class="title">科室管理</view>
    <view class="add-btn" bindtap="showAddModal">+ 添加</view>
  </view>

  <!-- 科室列表 -->
  <view class="dept-list">
    <view class="dept-item" wx:for="{{departments}}" wx:key="id">
      <view class="dept-info">
        <view class="dept-name">{{item.name}}</view>
        <view class="dept-desc">{{item.desc}}</view>
      </view>
      <view class="dept-actions">

        <button class="action-btn manage-btn" 
                bindtap="viewDoctors" 
                data-id="{{item.id}}" 
                data-name="{{item.name}}">
          管理医生
        </button>
        <button class="action-btn edit-btn" 
                bindtap="editDept" 
                data-id="{{item.id}}">
          编辑
        </button>
        <button class="action-btn delete-btn" 
                bindtap="deleteDept" 
                data-id="{{item.id}}">
          删除
        </button>
      </view>
    </view>
  </view>

  <!-- 科室编辑弹窗 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-content">
      <view class="modal-header">{{modalTitle}}</view>
      <view class="form-group">
        <label>科室名称</label>
        <input bindinput="onDeptNameInput" value="{{deptName}}" placeholder="请输入科室名称" />
      </view>
      <view class="form-group">
        <label>科室描述</label>
        <textarea bindinput="onDeptDescInput" value="{{deptDesc}}" placeholder="请输入科室描述"></textarea>
      </view>
      <view class="modal-actions">
        <button bindtap="closeModal">取消</button>
        <button bindtap="submitDept" type="primary">确定</button>
      </view>
    </view>
  </view>

  <!-- 🔥 新增：医生管理弹窗 -->
  <view class="modal large-modal" wx:if="{{showDoctorModal}}">
    <view class="modal-content">
      <view class="modal-header">
        {{currentDeptName}} - 医生管理
        <button class="close-btn" bindtap="closeDoctorModal">×</button>
      </view>
      
      <view class="doctor-header">
        <button class="add-doctor-btn" bindtap="showAddDoctorModal">+ 添加医生</button>
      </view>

      <!-- 医生列表 -->
      <view class="doctor-list">
        <view class="doctor-item" wx:for="{{doctors}}" wx:key="id">
          <view class="doctor-info">
            <view class="doctor-name">{{item.name}}</view>
            <view class="doctor-title">{{item.title}}</view>
            <view class="doctor-specialty">专长：{{item.specialty}}</view>
            <view class="doctor-schedule">排班：{{item.schedule}}</view>
            <view class="doctor-status {{item.status === 1 ? 'active' : 'inactive'}}">
              {{item.status === 1 ? '已上架' : '已下架'}}
            </view>
          </view>
          <view class="doctor-actions">
            <button class="action-btn {{item.status === 1 ? 'offline-btn' : 'online-btn'}}" 
                    bindtap="toggleDoctorStatus" 
                    data-id="{{item.id}}" 
                    data-status="{{item.status}}">
              {{item.status === 1 ? '下架' : '上架'}}
            </button>
            <button class="action-btn edit-btn" 
                    bindtap="editDoctor" 
                    data-id="{{item.id}}">
              编辑
            </button>
            <button class="action-btn delete-btn" 
                    bindtap="deleteDoctor" 
                    data-id="{{item.id}}">
              删除
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
