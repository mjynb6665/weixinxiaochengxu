/* pages/profile/profile.wxss */

.profile-container {
  padding: 40rpx 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.profile-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.profile-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 12rpx;
}

.profile-phone {
  font-size: 28rpx;
  color: #888;
}

.profile-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-section button {
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
}

.back-btn {
  display: flex;
  align-items: center;
  color: #1890ff;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}
.back-icon {
  font-size: 40rpx;
  margin-right: 8rpx;
}