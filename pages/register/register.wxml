<view class="reg-container">
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">←</text>
    <text>返回</text>
  </view>
  
  <!-- 添加就诊人信息部分 -->
  <view class="form-section">
    <view class="section-title">就诊人信息</view>
    <view class="form-item">
      <text>代人挂号</text>
      <switch checked="{{isProxy}}" bindchange="toggleProxyRegistration"/>
    </view>
    
    <block wx:if="{{isProxy}}">
      <view class="form-item">
        <text>就诊人姓名</text>
        <input 
          type="text"
          placeholder="请输入就诊人姓名"
          value="{{patientName}}"
          bindinput="onPatientNameInput"
        />
      </view>
      <view class="form-item">
        <text>代理人</text>
        <view class="info-value">{{currentUser.name}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="form-item">
        <text>就诊人</text>
        <view class="info-value">{{currentUser.name}}</view>
      </view>
    </block>
  </view>

  <!-- 挂号信息部分 -->
  <view class="form-section">
    <view class="section-title">挂号信息</view>
    <view class="form-item">
      <text>选择日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="picker">{{date || '请选择日期'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text>选择时间段</text>
      <picker mode="selector" range="{{timeSlots}}" value="{{timeIndex}}" bindchange="onTimeChange">
        <view class="picker">{{timeSlots[timeIndex]}}</view>
      </picker>
    </view>
  </view>

  <!-- 支付方式部分 -->
  <view class="form-section">
    <view class="section-title">支付方式</view>
    <view class="form-item">
      <radio-group bindchange="onPayTypeChange" value="{{payType}}">
        <block wx:for="{{payTypes}}" wx:key="item">
          <label class="pay-radio">
            <radio value="{{item}}" checked="{{payType === item}}"/>{{item}}支付
          </label>
        </block>
      </radio-group>
    </view>
  </view>

  <button class="submit-btn" bindtap="submitregistration">确认挂号并支付</button>
</view>