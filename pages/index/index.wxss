/* index.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f7fa;
  padding: 24rpx;
}

.main-content {
  flex: 1;
}

/* 搜索区域 */
.search-box {
  display: flex;
  padding: 20rpx;
  background-color: white;
}

.search-input {
  flex: 1;
  height: 70rpx;
  border-radius: 35rpx;
  background-color: #f5f7fa;
  padding: 0 30rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.placeholder {
  color: #999;
}

.search-btn {
  width: 140rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  background-color: #1890ff;
  color: white;
  font-size: 28rpx;
  padding: 0;
}

/* 导航菜单 */
.nav-items {
  display: flex;
  background-color: white;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.nav-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
}

/* 快捷操作区 */
.quick-actions {
  display: flex;
  padding: 30rpx 20rpx;
  background-color: white;
  margin-top: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 15rpx;
}

/* 科室分类 */
.section-title {
  font-size: 36rpx;
  font-weight: bold;
  padding: 30rpx 20rpx 20rpx;
  background-color: white;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
}

.department-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx 20rpx;
  background-color: white;
  gap: 24rpx;
}

.department-card {
  width: 320rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dept-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
}

.dept-name {
  font-size: 32rpx;
  font-weight: bold;
}

.dept-desc {
  font-size: 24rpx;
  color: #888;
  text-align: center;
}

/* 公告通知 */
.notice-list {
  background-color: white;
  padding: 0 20rpx 30rpx;
}

.notice-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.notice-title {
  font-size: 28rpx;
  color: #333;
}

.notice-date {
  font-size: 24rpx;
  color: #999;
}

/* 医院头部 */
.hospital-header {
  width: 100%;
  background: #1890ff;
  padding: 40rpx 0 20rpx 0;
  text-align: center;
}

.hospital-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

/* 底部信息 */
.footer {
  background-color: white;
  padding: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  margin-bottom: 120rpx; /* 避免被底部按钮挡住 */
}

/* 固定底部栏 */
.fixed-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0 32rpx 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
}

.fixed-bottom-bar button {
  flex: 1;
  margin: 0 20rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}
