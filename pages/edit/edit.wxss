.edit-container {
  padding: 40rpx 24rpx;
}
.edit-input {
  display: block;
  width: 100%;
  margin-bottom: 32rpx;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 32rpx;
}
.save-btn {
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
}
.back-btn {
  display: flex;
  align-items: center;
  color: #1890ff;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}
.back-icon {
  font-size: 40rpx;
  margin-right: 8rpx;
}