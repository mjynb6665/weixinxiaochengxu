<!-- pages/appointment/index.wxml -->
<view class="container">
  <!-- 导航栏部分保持不变 -->
  <view class="custom-nav-bar">
    <view class="nav-left" bindtap="navigateBack">
      <image src="/images/icon-back.png" class="nav-icon"></image>
      <text class="nav-text">返回</text>
    </view>
    <view class="nav-title">
      <text class="title-text">门诊预约</text>
      <text class="sub-title">请选择就诊人</text>
    </view>
    <view class="nav-right"></view>
  </view>
  <!-- 主体内容 -->
  <scroll-view class="main-content" scroll-y>
    <!-- 就诊人选择 -->
    <view class="section-card">
      <view class="section-title">
        <image src="/images/icon-user.png" class="section-icon"></image>
        <text>就诊人信息</text>
      </view>
      <view class="patient-info">
        <block wx:if="{{!isProxyRegistration}}">
          <view class="self-info">
            <text class="label">就诊人：</text>
            <text class="value">{{currentUser.name || "未登录"}}</text>
          </view>
        </block>
        
        <!-- 帮人挂号选项 -->
        <view class="proxy-section">
          <view class="input-group">
            <label>帮他人挂号</label>
            <switch checked="{{isProxyRegistration}}" bindchange="toggleProxyRegistration" color="#4171ff"/>
          </view>
          <block wx:if="{{isProxyRegistration}}">
            <view class="input-group">
              <label>就诊人姓名</label>
              <input 
                type="text"
                placeholder="请输入就诊人姓名"
                bindinput="onPatientNameInput"
                value="{{patientName}}"
              />
            </view>
            <view class="tips">请确保所填写的就诊人信息真实有效</view>
          </block>
        </view>
      </view>
    </view>
    <!-- 科室选择 -->
    <view class="section-card">
      <view class="section-title">
        <image src="/images/icon-department.png" class="section-icon"></image>
        <text>选择科室</text>
      </view>

      <view class="department-grid">
        <view
          wx:for="{{departments}}"
          wx:key="id"
          class="department-item"
          bindtap="selectDepartment"
          data-id="{{item.id}}"
        >
          <image src="{{item.icon}}" class="dept-icon"></image>
          <text class="dept-name">{{item.name}}</text>
        </view>
      </view>
    </view>
    <!-- 医生列表 -->
    <view class="section-card">
      <view class="section-title">
        <image src="/images/icon-doctor.png" class="section-icon"></image>
        <text>推荐医生</text>
      </view>

      <view class="doctor-list">
        <view
          wx:for="{{doctors}}"
          wx:key="id"
          class="doctor-card"
          bindtap="viewDoctorDetail"
          data-id="{{item.id}}"
        >
          <image src="{{item.avatar}}" class="doctor-avatar"></image>
          <view class="doctor-info">
            <view class="doctor-header">
              <text class="doctor-name">{{item.name}}</text>
              <text class="doctor-title">{{item.title}}</text>
            </view>
            <text class="doctor-specialty">{{item.specialty}}</text>
            <view class="doctor-footer">
              <text class="hospital">{{item.hospital}}</text>
              <button class="book-btn">预约</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>